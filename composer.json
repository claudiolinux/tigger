{
    "name": "tigger/tigger",
    "description": "A tiny, Express.js-inspired micro-framework for PHP 8.3+ with zero dependencies.",
    "type": "library",
    "license": "MIT",
    "keywords": ["framework", "router", "middleware", "express", "micro-framework"],
    "require": {
        "php": ">=8.3"
    },
    "autoload": {
        "psr-4": {
            "Tigger\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
